# Set ONE credential. The app reads them from the environment (it does not load .env itself).

# Console API key - works for Messages API, Agent SDK and Managed Agents
ANTHROPIC_API_KEY=

# Or a bearer token - Messages API + Agent SDK
# ANTHROPIC_AUTH_TOKEN=

# Or a Claude Code OAuth token from `claude setup-token` - Agent SDK (+ Messages API via OAuth beta header)
# CLAUDE_CODE_OAUTH_TOKEN=

# Set by the judge harness during scoring. Do not change it in code.
# ANTHROPIC_BASE_URL=
